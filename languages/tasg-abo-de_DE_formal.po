#: src/Admin/EmailDesigner.php
msgid "Subscription emails"
msgstr "Abo-E-Mails"

#: src/Admin/EmailDesigner.php
msgid "Not allowed."
msgstr "Nicht erlaubt."

#: src/Admin/EmailDesigner.php
msgid "The subscription emails are designed in YayMail (YayMail > Email templates, source \"Tasg Abo\"). To use the plugin editor instead, change \"Email design\" in WooCommerce > Subscription settings."
msgstr "Die Abo-E-Mails werden in YayMail gestaltet (YayMail > E-Mail-Vorlagen, Quelle \"Tasg Abo\"). Um stattdessen den Plugin-Editor zu verwenden, ändern Sie \"E-Mail-Gestaltung\" unter WooCommerce > Abo-Einstellungen."

#: src/Admin/EmailDesigner.php
msgid "Saved."
msgstr "Gespeichert."

#: src/Admin/EmailDesigner.php
msgid "Test email sent to your address."
msgstr "Test-E-Mail an Ihre Adresse gesendet."

#: src/Admin/EmailDesigner.php
msgid "The test email could not be sent. Check your mail setup."
msgstr "Die Test-E-Mail konnte nicht gesendet werden. Bitte prüfen Sie Ihre Mail-Einrichtung."

#: src/Admin/EmailDesigner.php
msgid "Placeholders:"
msgstr "Platzhalter:"

#: src/Admin/EmailDesigner.php
msgid "Leave subject or heading empty to use the default. Logo, colours and footer are set in WooCommerce > Settings > Emails."
msgstr "Lassen Sie Betreff oder Überschrift leer, um den Standard zu verwenden. Logo, Farben und Fußzeile stellen Sie unter WooCommerce > Einstellungen > E-Mails ein."

#: src/Admin/EmailDesigner.php
msgid "Subject"
msgstr "Betreff"

#: src/Admin/EmailDesigner.php
msgid "Heading"
msgstr "Überschrift"

#: src/Admin/EmailDesigner.php
msgid "Text"
msgstr "Text"

#: src/Admin/EmailDesigner.php
msgid "Sends the saved version with sample data to your own email address. Save first."
msgstr "Sendet die gespeicherte Version mit Beispieldaten an Ihre eigene E-Mail-Adresse. Bitte zuerst speichern."

#: src/Admin/EmailDesigner.php
msgid "Send test email to me"
msgstr "Test-E-Mail an mich senden"

#: src/Admin/PlansPage.php
msgid "Subscription plans"
msgstr "Abo-Pläne"

#: src/Admin/PlansPage.php
msgid "Plan saved."
msgstr "Plan gespeichert."

#: src/Admin/PlansPage.php
msgid "Plan deleted. Existing subscriptions keep running with their own copy of the plan."
msgstr "Plan gelöscht. Bestehende Abos laufen mit ihrer eigenen Kopie des Plans weiter."

#: src/Admin/PlansPage.php
msgid "A plan is a period with its own reminder time, for example \"Weekly\" or \"Every 4 months\". Assign plans to products on the product page. A product can offer several plans."
msgstr "Ein Plan ist ein Zeitraum mit eigener Erinnerungszeit, zum Beispiel \"Wöchentlich\" oder \"Alle 4 Monate\". Ordnen Sie Pläne auf der Produktseite Produkten zu. Ein Produkt kann mehrere Pläne anbieten."

#: src/Admin/PlansPage.php
msgid "The reminder time must be shorter than the period."
msgstr "Die Erinnerungszeit muss kürzer sein als der Zeitraum."

#: src/Admin/PlansPage.php
msgid "Please enter a period and a reminder time of at least 1."
msgstr "Bitte geben Sie einen Zeitraum und eine Erinnerungszeit von mindestens 1 ein."

#: src/Admin/PlansPage.php
msgid "Name"
msgstr "Name"

#: src/Admin/PlansPage.php
msgid "Period"
msgstr "Zeitraum"

#: src/Admin/PlansPage.php
msgid "Reminder before charge"
msgstr "Erinnerung vor der Abbuchung"

#: src/Admin/PlansPage.php
msgid "Visible to"
msgstr "Sichtbar für"

#: src/Admin/PlansPage.php
msgid "No plans yet. Add your first plan below."
msgstr "Noch keine Pläne. Fügen Sie unten Ihren ersten Plan hinzu."

#: src/Admin/PlansPage.php
msgid "Shop managers only (test plan)"
msgstr "Nur Shop-Manager (Testplan)"

#: src/Admin/PlansPage.php
msgid "Everyone"
msgstr "Alle"

#: src/Admin/PlansPage.php
msgid "Nobody (switched off)"
msgstr "Niemand (ausgeschaltet)"

#: src/Admin/PlansPage.php
msgid "(less than 48 hours)"
msgstr "(weniger als 48 Stunden)"

#: src/Admin/PlansPage.php
msgid "(default)"
msgstr "(Standard)"

#: src/Admin/PlansPage.php
msgid "Edit"
msgstr "Bearbeiten"

#: src/Admin/PlansPage.php
msgid "Delete"
msgstr "Löschen"

#: src/Admin/PlansPage.php
msgid "Edit plan"
msgstr "Plan bearbeiten"

#: src/Admin/PlansPage.php
msgid "Add plan"
msgstr "Plan hinzufügen"

#: src/Admin/PlansPage.php
msgid "Shown to customers, for example \"Weekly\". Leave empty to show the period."
msgstr "Wird Kunden angezeigt, zum Beispiel \"Wöchentlich\". Leer lassen, um den Zeitraum anzuzeigen."

#: src/Admin/PlansPage.php
msgid "How often a new order is made. For tests you can use minutes, hours or days."
msgstr "Wie oft eine neue Bestellung erzeugt wird. Für Tests können Sie Minuten, Stunden oder Tage verwenden."

#: src/Admin/PlansPage.php
msgid "Reminder email before the charge"
msgstr "Erinnerungs-E-Mail vor der Abbuchung"

#: src/Admin/PlansPage.php
msgid "Minutes"
msgstr "Minuten"

#: src/Admin/PlansPage.php
msgid "Hours"
msgstr "Stunden"

#: src/Admin/PlansPage.php
msgid "Days"
msgstr "Tage"

#: src/Admin/PlansPage.php
msgid "The customer gets the reminder at least this long before being charged. We recommend 48 hours or more for plans customers use. Must be shorter than the period."
msgstr "Der Kunde erhält die Erinnerung mindestens so lange vor der Abbuchung. Für Pläne, die Kunden nutzen, empfehlen wir 48 Stunden oder mehr. Muss kürzer sein als der Zeitraum."

#: src/Admin/PlansPage.php
msgid "Test plan"
msgstr "Testplan"

#: src/Admin/PlansPage.php
msgid "Only shop managers can see this plan"
msgstr "Nur Shop-Manager sehen diesen Plan"

#: src/Admin/PlansPage.php
msgid "Active"
msgstr "Aktiv"

#: src/Admin/PlansPage.php
msgid "Offer this plan"
msgstr "Diesen Plan anbieten"

#: src/Admin/PlansPage.php
msgid "Default plan"
msgstr "Standardplan"

#: src/Admin/PlansPage.php
msgid "Preselected for customers, and ticked on new products"
msgstr "Für Kunden vorausgewählt und bei neuen Produkten angehakt"

#: src/Admin/PlansPage.php
msgid "Save plan"
msgstr "Plan speichern"

#: src/Admin/ProductSettings.php
msgid "Subscription"
msgstr "Abo"

#: src/Admin/ProductSettings.php
msgid "Let customers subscribe to this product."
msgstr "Kunden dürfen dieses Produkt abonnieren."

#: src/Admin/ProductSettings.php
msgid "Subscriber discount type"
msgstr "Art des Abo-Rabatts"

#: src/Admin/ProductSettings.php
msgid "Percent"
msgstr "Prozent"

#: src/Admin/ProductSettings.php
msgid "Fixed amount"
msgstr "Fester Betrag"

#: src/Admin/ProductSettings.php
msgid "Subscriber discount"
msgstr "Abo-Rabatt"

#: src/Admin/ProductSettings.php
msgid "Taken off the price of every subscription order. Leave empty for no discount. A plan below can have its own discount."
msgstr "Wird vom Preis jeder Abo-Bestellung abgezogen. Leer lassen für keinen Rabatt. Ein Plan unten kann einen eigenen Rabatt haben."

#: src/Admin/ProductSettings.php
msgid "Plans offered"
msgstr "Angebotene Pläne"

#: src/Admin/ProductSettings.php
msgid "No plans yet. Create them under WooCommerce > Subscription plans."
msgstr "Noch keine Pläne. Legen Sie sie unter WooCommerce > Abo-Pläne an."

#: src/Admin/ProductSettings.php
msgid "(test plan)"
msgstr "(Testplan)"

#: src/Admin/ProductSettings.php
msgid "Discount"
msgstr "Rabatt"

#: src/Admin/ProductSettings.php
msgid "Default for this product"
msgstr "Standard für dieses Produkt"

#: src/Admin/SettingsPage.php
msgid "Subscription settings"
msgstr "Abo-Einstellungen"

#: src/Admin/SettingsPage.php
msgid "Test phase"
msgstr "Testphase"

#: src/Admin/SettingsPage.php
msgid "Only shop managers can see and use subscriptions"
msgstr "Nur Shop-Manager können Abos sehen und nutzen"

#: src/Admin/SettingsPage.php
msgid "Keep this on until you tested a full cycle yourself. Customers then see nothing. Untick it to open subscriptions to everyone."
msgstr "Lassen Sie dies eingeschaltet, bis Sie einen kompletten Ablauf selbst getestet haben. Kunden sehen dann nichts. Entfernen Sie den Haken, um Abos für alle zu öffnen."

#: src/Admin/SettingsPage.php
msgid "Status of renewal orders after payment"
msgstr "Status der Folgebestellungen nach der Zahlung"

#: src/Admin/SettingsPage.php
msgid "Choose the status your invoice, delivery note and label automation reacts to."
msgstr "Wählen Sie den Status, auf den Ihre Automatik für Rechnung, Lieferschein und Versandetikett reagiert."

#: src/Admin/SettingsPage.php
msgid "Days between pause reminders"
msgstr "Tage zwischen den Pause-Erinnerungen"

#: src/Admin/SettingsPage.php
msgid "A paused customer gets three reminders to continue or cancel. Without an answer the subscription is cancelled."
msgstr "Ein pausierter Kunde erhält drei Erinnerungen, fortzusetzen oder zu kündigen. Ohne Antwort wird das Abo gekündigt."

#: src/Admin/SettingsPage.php
msgid "Skip the next order"
msgstr "Die nächste Bestellung überspringen"

#: src/Admin/SettingsPage.php
msgid "Pause for the next period"
msgstr "Für die nächste Periode pausieren"

#: src/Admin/SettingsPage.php
msgid "Change the shipping address of the next order"
msgstr "Die Lieferadresse der nächsten Bestellung ändern"

#: src/Admin/SettingsPage.php
msgid "Change the plan (period)"
msgstr "Den Plan (Zeitraum) ändern"

#: src/Admin/SettingsPage.php
msgid "Change the payment method (Stripe)"
msgstr "Die Zahlungsmethode ändern (Stripe)"

#: src/Admin/SettingsPage.php
msgid "See the past orders of the subscription"
msgstr "Die bisherigen Bestellungen des Abos sehen"

#: src/Admin/SettingsPage.php
msgid "Automatic: YayMail if it is installed, otherwise the plugin editor"
msgstr "Automatisch: YayMail, falls installiert, sonst der Plugin-Editor"

#: src/Admin/SettingsPage.php
msgid "YayMail"
msgstr "YayMail"

#: src/Admin/SettingsPage.php
msgid "The plugin editor"
msgstr "Der Plugin-Editor"

#: src/Admin/SettingsPage.php
msgid "Email design"
msgstr "E-Mail-Gestaltung"

#: src/Admin/SettingsPage.php
msgid "YayMail was found on this site."
msgstr "YayMail wurde auf dieser Seite gefunden."

#: src/Admin/SettingsPage.php
msgid "YayMail was not found on this site, so the plugin editor is used."
msgstr "YayMail wurde auf dieser Seite nicht gefunden, deshalb wird der Plugin-Editor verwendet."

#: src/Admin/SettingsPage.php
msgid "Design the subscription emails in YayMail (YayMail > Email templates) or in the plugin editor (WooCommerce > Subscription emails)."
msgstr "Gestalten Sie die Abo-E-Mails in YayMail (YayMail > E-Mail-Vorlagen) oder im Plugin-Editor (WooCommerce > Abo-E-Mails)."

#: src/Admin/SettingsPage.php
msgid "Expiring card warning"
msgstr "Warnung bei ablaufender Karte"

#: src/Admin/SettingsPage.php
msgid "Email customers whose saved card expires before the next order"
msgstr "Kunden per E-Mail warnen, deren gespeicherte Karte vor der nächsten Bestellung abläuft"

#: src/Admin/SettingsPage.php
msgid "Check this many days before the order:"
msgstr "So viele Tage vor der Bestellung prüfen:"

#: src/Admin/SettingsPage.php
msgid "Only for Stripe cards, and only while customers may change their payment method (see below), because the email links to that page."
msgstr "Nur für Stripe-Karten und nur, solange Kunden ihre Zahlungsmethode ändern dürfen (siehe unten), weil die E-Mail auf diese Seite verlinkt."

#: src/Admin/SettingsPage.php
msgid "What customers may do"
msgstr "Was Kunden selbst tun dürfen"

#: src/Admin/SettingsPage.php
msgid "Cancelling is always possible for customers (contracts concluded online in Germany need an easy way to cancel). Continuing after a pause is always possible too."
msgstr "Kunden können immer kündigen (in Deutschland online geschlossene Verträge brauchen eine einfache Kündigungsmöglichkeit). Das Fortsetzen nach einer Pause ist ebenfalls immer möglich."

#: src/Admin/SettingsPage.php
msgid "PayPal (experimental)"
msgstr "PayPal (experimentell)"

#: src/Admin/SettingsPage.php
msgid "Offer PayPal for subscriptions"
msgstr "PayPal für Abos anbieten"

#: src/Admin/SettingsPage.php
msgid "Needs the WooCommerce PayPal Payments plugin with saving of PayPal payment methods enabled, and the customer must save the method at checkout. Without a saved method the subscription is not created. Try it with a test purchase first."
msgstr "Benötigt das Plugin WooCommerce PayPal Payments mit aktiviertem Speichern von PayPal-Zahlungsarten, und der Kunde muss die Zahlungsart an der Kasse speichern. Ohne gespeicherte Zahlungsart wird das Abo nicht angelegt. Testen Sie es zuerst mit einer Testbestellung."

#: src/Admin/SubscriptionsPage.php
msgid "Subscriptions"
msgstr "Abos"

#: src/Admin/SubscriptionsPage.php
msgid "Copy from last order"
msgstr "Von der letzten Bestellung übernehmen"

#: src/Admin/SubscriptionsPage.php
msgid "Free shipping"
msgstr "Gratisversand"

#: src/Admin/SubscriptionsPage.php
msgid "Free shipping until (empty = no end)"
msgstr "Gratisversand bis (leer = kein Ende)"

#: src/Admin/SubscriptionsPage.php
msgid "The reminder email is switched off. No subscription will be charged until you switch it on under WooCommerce > Settings > Emails."
msgstr "Die Erinnerungs-E-Mail ist ausgeschaltet. Es wird kein Abo abgebucht, bis Sie sie unter WooCommerce > Einstellungen > E-Mails einschalten."

#: src/Admin/SubscriptionsPage.php
msgid "Shipping for all active subscriptions"
msgstr "Versand für alle aktiven Abos"

#: src/Admin/SubscriptionsPage.php
msgid "Apply to all active"
msgstr "Auf alle aktiven anwenden"

#: src/Admin/SubscriptionsPage.php
msgid "Customer"
msgstr "Kunde"

#: src/Admin/SubscriptionsPage.php
msgid "Product"
msgstr "Produkt"

#: src/Admin/SubscriptionsPage.php
msgid "Every"
msgstr "Alle"

#: src/Admin/SubscriptionsPage.php
msgid "Status"
msgstr "Status"

#: src/Admin/SubscriptionsPage.php
msgid "Next payment (UTC)"
msgstr "Nächste Zahlung (UTC)"

#: src/Admin/SubscriptionsPage.php
msgid "Shipping"
msgstr "Versand"

#: src/Admin/SubscriptionsPage.php
msgid "Save"
msgstr "Speichern"

#: src/Admin/SubscriptionsPage.php
msgid "Pause"
msgstr "Pausieren"

#: src/Admin/SubscriptionsPage.php
msgid "Continue"
msgstr "Fortsetzen"

#: src/Admin/SubscriptionsPage.php
msgid "Cancel"
msgstr "Kündigen"

#: src/Cart/CartHandler.php
msgid "Please choose a subscription plan."
msgstr "Bitte wählen Sie einen Abo-Plan."

#: src/Cart/SingleItemRule.php
msgid "A subscription is always for one piece."
msgstr "Ein Abo gilt immer für ein Stück."

#: src/Cart/SingleItemRule.php
msgid "A subscription must be ordered on its own. Please finish or empty your cart first."
msgstr "Ein Abo muss einzeln bestellt werden. Bitte schließen Sie zuerst Ihren Warenkorb ab oder leeren Sie ihn."

#: src/Cart/SingleItemRule.php
msgid "A subscription must be ordered on its own. Please remove the other products from your cart."
msgstr "Ein Abo muss einzeln bestellt werden. Bitte entfernen Sie die anderen Produkte aus Ihrem Warenkorb."

#: src/Emails/CardExpiringEmail.php
msgid "Card expires before next order"
msgstr "Karte läuft vor der nächsten Bestellung ab"

#: src/Emails/CardExpiringEmail.php
msgid "Sent when the saved card of a subscription expires before the next order, so the customer can choose another payment method in time."
msgstr "Wird gesendet, wenn die gespeicherte Karte eines Abos vor der nächsten Bestellung abläuft, damit der Kunde rechtzeitig eine andere Zahlungsmethode wählen kann."

#: src/Emails/CardExpiringEmail.php
msgid "Your payment method expires before your next order of {product_name}"
msgstr "Ihre Zahlungsmethode läuft vor Ihrer nächsten Bestellung von {product_name} ab"

#: src/Emails/CardExpiringEmail.php
msgid "Your card is about to expire"
msgstr "Ihre Karte läuft bald ab"

#: src/Emails/CardExpiringEmail.php
msgid "Hello {customer_name},\n\nthe payment method {card_name} for your subscription of {product_name} expires on {card_expiry}, before your next order on {next_date}. Please choose another payment method so that your order can be charged:\n{payment_url}\n\nIf the payment fails, the subscription is cancelled."
msgstr "Hallo {customer_name},\n\ndie Zahlungsmethode {card_name} für Ihr Abo von {product_name} läuft am {card_expiry} ab, vor Ihrer nächsten Bestellung am {next_date}. Bitte wählen Sie eine andere Zahlungsmethode, damit Ihre Bestellung abgebucht werden kann:\n{payment_url}\n\nWenn die Zahlung fehlschlägt, wird das Abo gekündigt."

#: src/Emails/EmailTexts.php
msgid "All languages"
msgstr "Alle Sprachen"

#: src/Emails/FailedEmail.php
msgid "Subscription payment failed"
msgstr "Abo-Zahlung fehlgeschlagen"

#: src/Emails/FailedEmail.php
msgid "Sent when a renewal could not be charged. No order is created and the subscription is cancelled."
msgstr "Wird gesendet, wenn eine Verlängerung nicht abgebucht werden konnte. Es wird keine Bestellung erstellt und das Abo wird gekündigt."

#: src/Emails/FailedEmail.php
msgid "We could not charge your subscription for {product_name}"
msgstr "Wir konnten Ihr Abo für {product_name} nicht abbuchen"

#: src/Emails/FailedEmail.php
msgid "Your subscription was cancelled"
msgstr "Ihr Abo wurde gekündigt"

#: src/Emails/FailedEmail.php
msgid "Hello {customer_name},\n\nwe could not charge your payment method for your subscription of {product_name}. No order was created and the subscription is cancelled.\n\nYou are welcome to subscribe again in our shop at any time."
msgstr "Hallo {customer_name},\n\nwir konnten Ihr Zahlungsmittel für Ihr Abo von {product_name} nicht belasten. Es wurde keine Bestellung erstellt und das Abo ist gekündigt.\n\nSie können jederzeit in unserem Shop erneut ein Abo abschließen."

#: src/Emails/PauseReminderEmail.php
msgid "Subscription pause reminder"
msgstr "Erinnerung an die Abo-Pause"

#: src/Emails/PauseReminderEmail.php
msgid "Sent to a customer whose pause is over, asking them to continue or cancel. After the third reminder without an answer the subscription is cancelled."
msgstr "Wird an Kunden gesendet, deren Pause vorbei ist, mit der Bitte fortzusetzen oder zu kündigen. Nach der dritten Erinnerung ohne Antwort wird das Abo gekündigt."

#: src/Emails/PauseReminderEmail.php
msgid "Do you want to continue your subscription for {product_name}?"
msgstr "Möchten Sie Ihr Abo für {product_name} fortsetzen?"

#: src/Emails/PauseReminderEmail.php
msgid "Your subscription is paused"
msgstr "Ihr Abo ist pausiert"

#: src/Emails/PauseReminderEmail.php
msgid "Hello {customer_name},\n\nyour subscription for {product_name} is paused. Please tell us what you want to do. If we do not hear from you, the subscription will be cancelled after a few more reminders.\n\nContinue: {continue_url}\nCancel: {cancel_url}"
msgstr "Hallo {customer_name},\n\nIhr Abo für {product_name} ist pausiert. Bitte teilen Sie uns mit, wie es weitergehen soll. Wenn wir nichts von Ihnen hören, wird das Abo nach einigen weiteren Erinnerungen gekündigt.\n\nFortsetzen: {continue_url}\nKündigen: {cancel_url}"

#: src/Emails/ReminderEmail.php
msgid "Subscription reminder"
msgstr "Abo-Erinnerung"

#: src/Emails/ReminderEmail.php
msgid "Sent to the customer before the next subscription order is charged. How long before is set per plan."
msgstr "Wird dem Kunden vor der Abbuchung der nächsten Abo-Bestellung gesendet. Wie lange vorher, wird pro Plan festgelegt."

#: src/Emails/ReminderEmail.php
msgid "Your next order of {product_name} on {next_date}"
msgstr "Ihre nächste Bestellung von {product_name} am {next_date}"

#: src/Emails/ReminderEmail.php
msgid "Your next subscription order"
msgstr "Ihre nächste Abo-Bestellung"

#: src/Emails/ReminderEmail.php
msgid "Hello {customer_name},\n\nwe will charge you again for your next order of {product_name} on {next_date}. Amount: {amount} plus shipping.\n\nYour order will be sent to:\n{shipping_address}"
msgstr "Hallo {customer_name},\n\nwir buchen Ihre nächste Bestellung von {product_name} am {next_date} erneut ab. Betrag: {amount} zuzüglich Versand.\n\nIhre Bestellung wird an diese Adresse geschickt:\n{shipping_address}"

#: src/Emails/ReminderEmail.php
msgid "If this address is not correct, please change it before {next_date}: {address_url}"
msgstr "Wenn die Adresse nicht stimmt, ändern Sie sie bitte vor dem {next_date}: {address_url}"

#: src/Emails/ReminderEmail.php
msgid "You do not need to do anything else to continue."
msgstr "Sie müssen sonst nichts tun, Ihr Abo läuft weiter."

#: src/Emails/ReminderEmail.php
msgid "Skip this order: {skip_url}"
msgstr "Diese Bestellung überspringen: {skip_url}"

#: src/Emails/ReminderEmail.php
msgid "Pause: {pause_url}"
msgstr "Pausieren: {pause_url}"

#: src/Emails/ReminderEmail.php
msgid "Change your plan: {plan_url}"
msgstr "Plan ändern: {plan_url}"

#: src/Emails/ReminderEmail.php
msgid "Change your payment method: {payment_url}"
msgstr "Zahlungsmethode ändern: {payment_url}"

#: src/Emails/ReminderEmail.php
msgid "Cancel your subscription: {cancel_url}"
msgstr "Abo kündigen: {cancel_url}"

#: src/Emails/SubscriptionEmail.php
msgid "Email text"
msgstr "E-Mail-Text"

#: src/Emails/SubscriptionEmail.php
msgid "Placeholders: {customer_name} {product_name} {next_date} {amount} {cancel_url} {skip_url} {pause_url} {continue_url} {shipping_address} {address_url} {payment_url} {plan_url} {card_name} {card_expiry}"
msgstr "Platzhalter: {customer_name} {product_name} {next_date} {amount} {cancel_url} {skip_url} {pause_url} {continue_url} {shipping_address} {address_url} {payment_url} {plan_url} {card_name} {card_expiry}"

#: src/Frontend/LinkHandler.php
msgid "Link not valid"
msgstr "Link ungültig"

#: src/Frontend/LinkHandler.php
msgid "This link is not valid any more."
msgstr "Dieser Link ist nicht mehr gültig."

#: src/Frontend/LinkHandler.php
msgid "Not available"
msgstr "Nicht verfügbar"

#: src/Frontend/LinkHandler.php
