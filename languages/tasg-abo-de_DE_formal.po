msgstr "Nichts geändert"

#: src/Frontend/LinkHandler.php
msgid "This subscription cannot be changed this way right now."
msgstr "Dieses Abo kann derzeit auf diesem Weg nicht geändert werden."

#: src/Frontend/LinkHandler.php
msgid "Address saved"
msgstr "Adresse gespeichert"

#: src/Frontend/LinkHandler.php
