#: src/Frontend/LinkHandler.php
msgid "Please fill in all fields that are not marked optional."
msgstr "Bitte füllen Sie alle Felder aus, die nicht als optional gekennzeichnet sind."

#: src/Frontend/LinkHandler.php
msgid "We cannot ship to this country."
msgstr "In dieses Land können wir nicht liefern."

#: src/Frontend/LinkHandler.php
msgid "The postcode is not valid for this country."
msgstr "Die Postleitzahl ist für dieses Land nicht gültig."

#: src/Frontend/LinkHandler.php
msgid "Plan changed"
msgstr "Plan geändert"

#: src/Frontend/LinkHandler.php
msgid "Your plan was changed. You will get a reminder before the next order, with the new date and price."
msgstr "Ihr Plan wurde geändert. Vor der nächsten Bestellung erhalten Sie eine Erinnerung mit neuem Datum und Preis."

#: src/Frontend/LinkHandler.php
msgid "(current)"
msgstr "(aktuell)"

#: src/Frontend/LinkHandler.php
msgid "Choose a new plan"
msgstr "Neuen Plan wählen"

#: src/Frontend/LinkHandler.php
msgid "The payment method of this subscription cannot be changed here."
msgstr "Die Zahlungsmethode dieses Abos kann hier nicht geändert werden."

#: src/Frontend/LinkHandler.php
msgid "Payment method saved"
